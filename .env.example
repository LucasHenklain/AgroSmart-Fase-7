# ---------------------------------------------------------------------------
# AgroSmart Fase 5 - variáveis de ambiente
# Copie para .env  (`cp .env.example .env`) e ajuste o que precisar.
# O .env NÃO é versionado. Este .env.example é, e serve de documentação.
# ---------------------------------------------------------------------------

# Backend de armazenamento do Data Lake: "minio" ou "filesystem".
# minio      -> object store S3-compatível em Docker (caminho principal)
# filesystem -> pastas locais em ./datalake (plano B, mesma estrutura lógica)
AGROSMART_BACKEND=minio

# --- MinIO / S3 -------------------------------------------------------------
# Credenciais de desenvolvimento local. Não são segredo: o MinIO só escuta em
# localhost e o bucket não sai da máquina. Em nuvem, viriam de um secret manager.
AGROSMART_MINIO_ENDPOINT=http://localhost:9000
AGROSMART_MINIO_ACCESS_KEY=agrosmart
AGROSMART_MINIO_SECRET_KEY=agrosmart123
AGROSMART_MINIO_REGION=us-east-1

# Prefixo dos buckets: gera agrosmart-bronze, agrosmart-silver, etc.
AGROSMART_PREFIXO_BUCKET=agrosmart

# --- Simulação --------------------------------------------------------------
# Semente fixa: a mesma execução gera sempre os mesmos dados. Isso torna a
# demonstração reprodutível e os prints conferíveis pelo professor.
AGROSMART_SEED=20260905
AGROSMART_DIAS_HISTORICO=30
AGROSMART_QTD_TALHOES=6
# O "hoje" do pipeline. A simulação cobre os DIAS_HISTORICO anteriores a esta
# data, e as regras de freshness/não-futuro comparam com ela — não com o relógio
# da máquina. Fixa para que o resultado seja o mesmo em qualquer dia de execução.
AGROSMART_DATA_REFERENCIA=2026-09-01

# Threads por coletor na ingestão. Milhares de arquivos pequenos de sensores são
# limitados pela latência do object store; 8 threads reduzem a ingestão de 30 dias
# de ~100 s para ~15 s. Use 1 para depurar em sequência.
AGROSMART_PARALELISMO=8

# Sal da pseudonimização de dados pessoais no silver (responsavel_id → OPE~a1b2c3d4e5).
# Em produção viria de um cofre de segredos e nunca do repositório.
AGROSMART_SALT_PSEUDONIMIZACAO=agrosmart-fase5-dev

# --- IA generativa ----------------------------------------------------------
# Sem chave, o copiloto roda em modo mock/regras e a demo continua funcionando.
AGROSMART_IA_MODELO=claude-sonnet-5
ANTHROPIC_API_KEY=

# --- Observabilidade --------------------------------------------------------
AGROSMART_LOG_LEVEL=INFO
